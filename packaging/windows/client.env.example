# Client build configuration. Copy to packaging/windows/.env before package.cmd.
# Only these filtered client values are embedded in the Rust executables.
# Never place PostgreSQL credentials in this file or in the distributed package.
KEYGEN_CLOUD_API_URL=https://activation.example.com
# Limited seller/client token only. Never use KEYGEN_ADMIN_SECRET_TOKEN here.
KEYGEN_API_SECRET_TOKEN=replace-with-limited-client-token
KEYGEN_LISTEN_ADDRESS=127.0.0.1:45632
KEYGEN_STATUS_INTERVAL_SECONDS=300
