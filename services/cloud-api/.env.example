# Cloud API server configuration. Copy to .env only on the server.
PGHOST=sw4.duckdns.org
PGPORT=9005
PGDATABASE=keygen_restaurant
PGUSER=keygen_app
PGPASSWORD=replace-with-database-password
PGSSLMODE=require
PGCONNECT_TIMEOUT=10
KEYGEN_API_SECRET_TOKEN=replace-with-limited-client-token
# Required for dashboard control and status changes; never embed this in a client EXE.
KEYGEN_ADMIN_SECRET_TOKEN=replace-with-distinct-admin-token
FLASK_DEBUG=0

# Local FastAPI monitoring dashboard. Keep the default local-only binding.
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8080
